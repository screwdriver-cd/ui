<BsModal
  id="edit-token-modal"
  @onHide={{fn @closeModal}}
  as |modal|
>
  <modal.header>
    Edit a {{@token.type}} token
  </modal.header>
  <modal.body>
    {{#if this.errorMessage}}
      <InfoMessage
        id="error-message"
        @message={{this.errorMessage}}
        @type="warning"
        @icon="triangle-exclamation"
      />
    {{/if}}

    <div class="edit-token">
      <label>
        <div>Name:</div>
        <Input
          id="token-name-input"
          @type="text"
          @value={{this.tokenName}}
          placeholder={{@token.name}}
          class={{this.inputClass}}
          disabled={{this.inputDisabled}}
          autofocus={{true}}
        />
      </label>
      <label>
        <div>Description:</div>
        <Input
          id="token-description-input"
          @type="text"
          @value={{this.tokenDescription}}
          placeholder={{@token.description}}
          disabled={{this.inputDisabled}}
        />
      </label>
      <div class="powerselect-wrap">
        <div class="powerselect-label">Expires in:</div>
        <div class="current-token-value">Current: {{this.expiresDate}}</div>
        <div class="powerselect-control">
          <PowerSelect
            id="expires-select"
            @options={{this.expiresOptions}}
            @selected={{this.tokenExpires}}
            @placeholder="Leave unchanged"
            @renderInPlace={{true}}
            @onChange={{this.setTokenExpires}}
            as |option|
          >
            {{option.label}}
          </PowerSelect>
        </div>
      </div>
      <div class="powerselect-wrap">
        <div class="powerselect-label">Permission:</div>
        <div class="current-token-value">
          Current: {{@token.options.permission}}
        </div>
        <div class="powerselect-control">
          <PowerSelect
            id="token-permission-select"
            @options={{this.tokenPermissionOptions}}
            @selected={{this.tokenPermission}}
            @placeholder="Leave unchanged"
            @renderInPlace={{true}}
            @onChange={{this.setTokenPermission}}
            as |option|
          >
            {{option}}
          </PowerSelect>
        </div>
      </div>
    </div>
  </modal.body>
  <modal.footer>
    <BsButton
      id="submit-token"
      class="confirm"
      disabled={{this.isSubmitButtonDisabled}}
      @defaultText="Update token"
      @pendingText="Updating token..."
      @type="primary"
      @onClick={{fn this.editToken}}
    />
  </modal.footer>
</BsModal>
