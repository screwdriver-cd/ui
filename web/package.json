{
  "name": "screwdriver-ui-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">= 22"
  },
  "scripts": {
    "dev": "vite --port 5173 --strictPort",
    "dev:ssl": "SD_DEV_SSL=1 vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "lint": "eslint .",
    "i18n:extract": "formatjs extract 'src/**/*.{ts,tsx}' --ignore '**/*.test.*' --out-file extracted-messages.json --id-interpolation-pattern '[sha512:contenthash:base64:6]'"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.13.1",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@formatjs/icu-messageformat-parser": "^3.5.22",
    "@fortawesome/fontawesome-svg-core": "^6.7.2",
    "@fortawesome/free-regular-svg-icons": "^6.7.2",
    "@fortawesome/free-solid-svg-icons": "^6.7.2",
    "@fortawesome/react-fontawesome": "^0.2.6",
    "@tanstack/react-query": "^5.104.5",
    "@tanstack/react-router": "^1.170.45",
    "@tanstack/react-table": "^8.21.3",
    "@tanstack/react-virtual": "^3.14.21",
    "@xyflow/react": "^12.12.0",
    "ansi_up": "^6.0.6",
    "bootstrap": "^5.3.8",
    "codemirror": "^6.0.2",
    "date-fns": "^4.4.0",
    "elkjs": "^0.12.0",
    "graphology": "^0.26.0",
    "graphology-dag": "^0.4.1",
    "graphology-traversal": "^0.3.1",
    "jwt-decode": "^4.0.0",
    "react": "^19.3.1",
    "react-bootstrap": "^2.10.10",
    "react-dom": "^19.3.1",
    "react-intl": "^12.1.5",
    "react-virtuoso": "^4.18.19",
    "yaml": "^2.9.1",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^9.39.5",
    "eslint-plugin-formatjs": "^8.1.2",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "sass": "^1.83.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
